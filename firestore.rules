rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sessions: Full read and write for scheduling sessions
    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    // Bookings: Full read and write for live slot reservations
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Blocked Slots: Full read and write for slot availability management
    match /blocked_slots/{blockedId} {
      allow read, write: if true;
    }

    // Attendees: Candidate check-in records and coordinator management
    match /attendees/{attendeeId} {
      allow read, write: if true;
    }

    // Activity Events: Append and read activity audit events
    match /events/{eventId} {
      allow read, write: if true;
    }
  }
}
