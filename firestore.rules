rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidSession() {
      let data = request.resource.data;
      return data.title is string &&
             data.title.size() > 0 &&
             data.date is string &&
             data.startTime is string &&
             data.endTime is string;
    }

    function isValidBooking() {
      let data = request.resource.data;
      return data.sessionId is string &&
             data.slotId is string &&
             data.candidateName is string &&
             data.candidateName.size() > 0 &&
             (data.candidateContact is string || data.candidateEmail is string);
    }

    function isValidAttendee() {
      let data = request.resource.data;
      return data.sessionId is string &&
             data.name is string &&
             data.name.size() > 0;
    }

    // Sessions: Public read for session schedules; Admin-only writes
    match /sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Bookings: Public read (slot occupancy status); Atomic create for open slots
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if isValidBooking();
      allow update: if isValidBooking();
      allow delete: if true;
    }

    // Blocked Slots: Public read (slot availability); Admin-only writes
    match /blocked_slots/{blockedId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Attendees: Candidate check-in create/update; Admin-only read/list (PII Protected)
    match /attendees/{attendeeId} {
      allow read: if isAuthenticated();
      allow create, update: if isValidAttendee();
      allow delete: if isAuthenticated();
    }

    // Activity Events: Append-only log; Admin-only read & audit
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if request.resource.data.type is string && request.resource.data.timestamp is string;
      allow update, delete: if isAuthenticated();
    }
  }
}
